  _nodes:
  - id: hello
    lines:
    - "\u2026\uD081. \uD081\uD081."
    - "\uB108\uD55C\uD14C\uC11C \uC774\uC0C1\uD55C \uB0C4\uC0C8\uAC00 \uB098. \uCD08\uB85D\uC0C9
      \uB0C4\uC0C8. \uB0A8\uC758 \uAC83\uC744 \uC624\uB798 \uBC14\uB77C\uBCF8 \uB0C4\uC0C8."
    ask: 
    choices: []
    next: menu
    end: 0
    dest: 
  - id: menu
    lines: []
    ask: "\u2026\uBB3C\uC5B4\uBD10. \uB300\uB2F5\uC740, \uBAA8\uB798\uAC00 \uAE30\uC5B5\uD558\uB294
      \uB9CC\uD07C\uB9CC."
    choices:
    - text: "\uB10C \uB300\uCCB4 \uBB50\uC9C0?"
      to: what
    - text: "\uC65C \uC774 \uAE38\uC744 \uACC4\uC18D \uB3CC\uC544\uB2E4\uB2C8\uC9C0?"
      to: walk
    - text: "\u2026\uC774\uB9CC \uAC08\uAC8C"
      to: bye
    next: 
    end: 0
    dest: 
  - id: what
    lines:
    - "\uC774\uB984\uC740 \uC5C6\uC5B4. \uC0AC\uB78C\uB4E4\uC774 \uD138\uBCF5\uC774\uB77C\uACE0
      \uBD88\uB7EC\uC11C, \uADF8\uB0E5 \uD138\uBCF5\uC774."
    - "\uB098\uB294 \uC774 \uB9C8\uC744 \uBC11\uC5D0\uC11C \uAE7C\uC5B4. \uADF8 \uC804\uC5D4\u2026
      \uB204\uAD70\uAC00\uC758 \uAFC8\uC774\uC5C8\uB358 \uAC83 \uAC19\uC544. \uC544\uC8FC
      \uAE38\uACE0, \uC544\uC8FC \uC878\uB9B0 \uAFC8."
    ask: 
    choices: []
    next: menu
    end: 0
    dest: 
  - id: walk
    lines:
    - "\uAE38\uC744 \uC138\uACE0 \uC788\uC5B4. \uC774 \uAE38\uC740 \uC5B4\uC81C\uBCF4\uB2E4
      \uC138 \uAC78\uC74C \uC9E7\uC544\uC84C\uC5B4."
    - "\uBAA8\uB798\uAC00 \uC870\uAE08\uC529 \uB9C8\uC744\uC744 \uC0BC\uD0A4\uB294
      \uC911\uC774\uC57C. \uC544\uBB34\uB3C4 \uBAA8\uB974\uAC8C, \uC544\uC8FC \uCC9C\uCC9C\uD788\u2026
      \uADF8\uBD84\uC774 \uB4A4\uCC99\uC77C \uB54C\uB9C8\uB2E4."
    ask: 
    choices: []
    next: menu
    end: 0
    dest: 
  - id: bye
    lines:
    - "\uAC00. \uD558\uC9C0\uB9CC \uAE30\uC5B5\uD574. \uBA48\uCDB0 \uC11C\uBA74,
      \uBAA8\uB798\uAC00 \uB108\uB97C \uC138\uAE30 \uC2DC\uC791\uD574."
